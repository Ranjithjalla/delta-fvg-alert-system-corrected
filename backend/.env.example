PORT=3000

# Delta public market-data endpoints are public and do not require keys.
# Keep these blank. Do NOT put private trading credentials in frontend code.
DELTA_API_KEY=
DELTA_API_SECRET=
DELTA_REST_BASE=https://api.india.delta.exchange
DELTA_WS_BASE=wss://public-socket.india.delta.exchange
DELTA_SYMBOL=BTCUSD

# Web Push
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:admin@example.com

# Telegram
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

DB_PATH=./data/fvg.db
HISTORY_CANDLES=720
WATCHDOG_INTERVAL_MS=15000
FEED_STALE_MULTIPLIER=3
